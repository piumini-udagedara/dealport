generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SELLER
}

enum ProductStatus {
  DRAFT
  PUBLISHED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  products  ProductTag[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Product {
  id          String        @id @default(cuid())
  name        String
  description String?
  sku         String?       @unique
  price       Decimal       @db.Decimal(10, 2)
  compareAt   Decimal?      @db.Decimal(10, 2)
  stock       Int           @default(0)
  status      ProductStatus @default(DRAFT)
  imageUrl    String?
  imageUrls   String[] @default([])
  salesCount  Int           @default(0)
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  tags        ProductTag[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([name])
  @@index([status])
  @@index([salesCount])
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}
