# Local development URL. On Railway, set DATABASE_URL in the dashboard instead
# (internal URL is fine there). For local dev, copy .env.local.example to .env.local.
DATABASE_URL="postgresql://postgres:password@localhost:5432/dealport?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=3001
CORS_ORIGIN="http://localhost:3000"
